{
  "name": "@poc-mach/papi",
  "version": "1.0.0",
  "main": "./dist/handler.js",
  "types": "./dist/handler.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npx esbuild src/handler.ts --bundle --platform=node --target=node20 --external:@aws-sdk/* --outfile=dist-lambda/handler.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-include='dist/**' --test-coverage-lines=90 dist/handler.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@poc-mach/sapi": "workspace:*",
    "@poc-mach/types": "workspace:*"
  },
  "devDependencies": {
    "@poc-mach/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
